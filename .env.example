# Copier en .env puis adapter.
# Mot de passe de l'interface (obligatoire)
ADMIN_PASSWORD=changez-moi
# Clé de chiffrement des mots de passe des boîtes et de signature des sessions.
# Vide = générée automatiquement dans data/secret.key (à sauvegarder !)
SECRET_KEY=
# Taille des chunks d'upload (octets), entre 16 et 64 Mo recommandé
UPLOAD_CHUNK_SIZE=33554432
# Marge d'espace disque exigée en plus de la taille du PST
UPLOAD_DISK_MARGIN=536870912
# Nombre de boîtes migrées simultanément par le worker
WORKER_CONCURRENCY=2
# Nombre de mails relus pour le contrôle par échantillon
VERIFY_SAMPLE=20
# Tentatives sur erreur IMAP temporaire (backoff exponentiel)
IMAP_MAX_RETRIES=5
# Chaque job/analyse tourne dans un sous-processus isolé : nombre de crashs (libpff) tolérés
# par job avant de le passer en échec
MAX_CHILD_CRASHES=3
# 1 = cookie de session « Secure » (derrière un reverse proxy HTTPS)
COOKIE_SECURE=0
