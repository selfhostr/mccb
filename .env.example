# Copy to .env and adjust. The whole file is optional: the stack starts with zero configuration.

# Admin password for the web UI (OPTIONAL).
# Empty/absent = a random password is generated on first start, stored hashed in data/admin.json
# and printed once in the web container log (docker compose logs web).
# To reset: delete data/admin.json and restart, or set ADMIN_PASSWORD (the env var always wins).
# ADMIN_PASSWORD=

# Key used to encrypt mailbox passwords and sign sessions.
# Empty = auto-generated in data/secret.key (back it up!)
SECRET_KEY=
# Upload chunk size (bytes); 16 to 64 MiB recommended
UPLOAD_CHUNK_SIZE=33554432
# Free disk space margin required on top of the PST size
UPLOAD_DISK_MARGIN=536870912
# Number of mailboxes migrated simultaneously by the worker. Unset or 0 = auto: sized from the cores,
# the memory, the disk and the queue (see docs/tuning.md). Set a value only to impose a limit.
# WORKER_CONCURRENCY=0
# Limits of the automatic tuning: IMAP connections per mailbox, and per server across all its mailboxes
# AUTOTUNE_MAX_CONNECTIONS=32
# AUTOTUNE_MAX_SERVER_CONNECTIONS=64
# Number of mails re-read for the sample check
VERIFY_SAMPLE=20
# Attempts on temporary IMAP errors (exponential backoff)
IMAP_MAX_RETRIES=5
# Each job/analysis runs in an isolated subprocess: number of (libpff) crashes tolerated
# per job before it is marked as failed
MAX_CHILD_CRASHES=3
# 1 = "Secure" session cookie (behind an HTTPS reverse proxy)
COOKIE_SECURE=0

# Drop folder watched by the worker (default: DATA_DIR/inbox). Can be a mount (NFS, SMB...).
# INBOX_DIR=
# Server-side fetch: simultaneous transfers (drop folder and downloads)
FETCH_PARALLEL=2
# 1 = also refuse private ranges (10/8, 172.16/12, 192.168/16, loopback) as fetch sources
FETCH_BLOCK_PRIVATE=0
# 1 = allow link-local / cloud metadata addresses as fetch sources (not recommended)
FETCH_ALLOW_LINK_LOCAL=0
# Repair tab: folder of a repaired mailbox that keeps the originals (keep it constant), and mailboxes in parallel
# REPAIR_BACKUP_FOLDER=_originaux_avant_reparation
# REPAIR_PARALLEL=2
