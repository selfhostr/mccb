[server]
hosts = 0.0.0.0:5232

[auth]
# utilisateurs créés par les tests (tests/svcusers.py) dans un fichier partagé par volume
type = htpasswd
htpasswd_filename = /users/htpasswd
htpasswd_encryption = plain
delay = 0

[rights]
type = owner_only

[storage]
filesystem_folder = /data/collections

[logging]
level = warning
